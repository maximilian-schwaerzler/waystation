# Instance ID for this Waystation deployment.
#
# On first run (no /data/.waystation-instance-id sentinel yet), the app generates a UUID,
# writes it to the sentinel file, and prints it with instructions to paste it here. Leave
# this unset until you've seen that output — copy the generated ID, don't invent your own.
#WAYSTATION_INSTANCE_ID=

# Host path (or network mount) bound to the container's /data.
#
# Defaults to ./data if unset. Point this at a Tailscale-connected NAS mount, etc. for
# off-VPS storage. This is a host-level decision only — the app never knows or cares
# whether it's local disk or a network mount.
#WAYSTATION_DATA_DIR=./data

# Full base URL (protocol + host, no trailing slash) used to build links returned to
# clients, e.g. https://files.example.com. Needed when running behind a reverse proxy
# (Traefik, etc.) where the outbound hostname differs from what the container itself
# sees. If unset, falls back to the request's Host header — fine for local dev, but not
# guaranteed correct behind a proxy.
#WAYSTATION_PUBLIC_URL=

# Log verbosity: trace, debug, info, warn, error, or fatal. Defaults to info. Lifecycle
# events (startup, readiness checks, errors) log at info; per-request detail logs at
# debug, so set this to debug when troubleshooting.
#WAYSTATION_LOG_LEVEL=info